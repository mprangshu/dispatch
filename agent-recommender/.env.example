# Copy this file to `.env` and fill in your key. `.env` is gitignored.

# LLM API key — used by the chatbot for intent detection, answer generation,
# and recommendation explanations. The default client is Google Gemini (see
# src/config.py MODEL). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides (defaults live in src/config.py):
# MODEL=gemini-2.5-flash
# EMBEDDING_MODEL=chroma-default
# TOP_K=4
